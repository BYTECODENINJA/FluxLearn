{
  "name": "fluxlearn",
  "version": "0.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "../node_modules/.bin/turbo run test",
    "build": "../node_modules/.bin/turbo run build",
    "dev": "node scripts/dev-preflight.mjs && ../node_modules/.bin/turbo run dev --continue",
    "lint": "../node_modules/.bin/turbo run lint",
    "typecheck": "../node_modules/.bin/turbo run typecheck",
    "test:e2e": "../node_modules/.bin/turbo run test:e2e",
    "seed": "pnpm --filter @fluxlearn/api run seed:demo",
    "clean": "../node_modules/.bin/turbo run clean && rm -rf node_modules",
    "format": "../node_modules/.bin/prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css}\"",
    "format:check": "../node_modules/.bin/prettier --check \"**/*.{js,jsx,ts,tsx,json,md,css}\"",
    "format:check:ci": "../node_modules/.bin/prettier --check \"**/*.{js,jsx,ts,tsx,json,md,css}\" --loglevel silent",
    "prepare": "../node_modules/.bin/husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yaml,yml}": [
      "prettier --write"
    ]
  }
}
