{
  "name": "@fluxlearn/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "sh -c 'stripe listen --skip-update --forward-to http://127.0.0.1:8000/api/v1/stripe/webhook --events checkout.session.completed,checkout.session.async_payment_failed & pid=$!; trap \"kill $pid 2>/dev/null\" EXIT INT TERM; tsx watch src/index.ts'",
    "stripe:listen": "stripe listen --skip-update --forward-to http://127.0.0.1:8000/api/v1/stripe/webhook --events checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.async_payment_failed",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "grant-role": "tsx src/jobs/grant-role.ts",
    "sync-role-keys": "tsx src/jobs/sync-role-keys.ts",
    "seed:demo": "tsx src/jobs/seed-demo.ts",
    "build:vercel": "node scripts/build-vercel.mjs"
  },
  "dependencies": {
    "@fluxlearn/config": "workspace:*",
    "@fluxlearn/types": "workspace:*",
    "@fluxlearn/ui": "workspace:*",
    "@imagekit/nodejs": "^7.15.0",
    "argon2": "^0.45.2",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.18",
    "mongoose": "^9.13.1",
    "nodemailer": "^10.6.1",
    "pdfkit": "^0.21.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "react": "^19.3.1",
    "resend": "^6.39.0",
    "stripe": "^23.2.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fluxlearn/eslint-config": "workspace:*",
    "@fluxlearn/tsconfig": "workspace:*",
    "@stripe/cli": "^1.55.15",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.9",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.1",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "mongodb-memory-server": "^11.4.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
