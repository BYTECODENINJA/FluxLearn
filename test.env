# ==============================================================================
# Schola - Environment Variables
# ==============================================================================
# This file is the committed source of truth for every env var the project
# needs. Every value here is a placeholder - secrets are blank.
# Local values live in `test.env` (gitignored). On first checkout, copy
# this file: `cp .env test.env`, then fill in the blanks in `test.env`.
# When you add a new env var, also update `test.env` and `docs/services/<service>.md`.
# A typed loader in @schola/config validates these at startup with Zod.

# ==============================================================================
# Section: Branding
# ==============================================================================
APP_NAME=Schola
# Dev (this file, local API): http://localhost:3000
# Prod (set on the host, not here): https://reactbd.com
APP_URL=http://localhost:3000
APP_SHORT_DESCRIPTION="Multi-tenant school management platform."

# ==============================================================================
# Section: Runtime
# ==============================================================================
# Dev: development. Prod host: production
NODE_ENV=development
LOG_LEVEL=info

# ==============================================================================
# Section: API server
# ==============================================================================
API_PORT=8000
# Dev: http://localhost:3000
# Prod: https://reactbd.com
CORS_ORIGIN=http://localhost:3000
# ==============================================================================
# Section: Database (Neon Postgres - identity)
# ==============================================================================
# What: Pooled Postgres connection string for accounts, OAuth, and email verification.
# Where to get: https://neon.tech -> project -> Connect -> pooled connection string.
# Docs: docs/services/neon.md
# Required: no until you run db:migrate. Password login still works on Mongo without it.
# Leave blank. Accounts live in Mongo (MONGODB_URI). A mongodb:// value here is not Postgres.
DATABASE_URL=

# What: Google OAuth web client. Used by the redirect flow, not the Firebase popup.
# Where to get: https://google.com
# Docs: docs/services/neon.md
# Required: no. The Google button reports that sign-in is not configured when blank.
# Authorized JavaScript origins (add both):
#   http://localhost:3000
#   https://reactbd.com
# Authorized redirect URIs (add both, no trailing slash):
#   http://localhost:3000/api/v1/auth/oauth/google/callback
#   https://reactbd.com/api/v1/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# What: Facebook Login app id and secret.
# Where to get: https://facebook.com
# Docs: docs/services/neon.md
# Required: no. The Facebook button reports that sign-in is not configured when blank.
# Valid OAuth Redirect URIs (add both):
#   http://localhost:3000/api/v1/auth/oauth/facebook/callback
#   https://reactbd.com/api/v1/auth/oauth/facebook/callback
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
# ==============================================================================
# Section: Database (MongoDB)
# ==============================================================================
# What: Connection string for MongoDB. Use Atlas in prod, local mongod in dev.
# Where to get (prod): create a free M0 cluster on MongoDB Atlas, then
#   Atlas -> Database -> Connect -> Drivers -> copy the `mongodb+srv://...` URI.
#   Signup: https://mongodb.com
#   Console: https://mongodb.com
# Where to get (dev): default below works against a local `mongod` on port 27017.
# Docs: docs/services/mongodb-atlas.md
# Required: yes
# scholaadmin
MONGODB_URI=

# ==============================================================================
# Section: Auth (JWT + Argon2 + CSRF)
# ==============================================================================
# What: Random 64-char hex strings. Different for access vs refresh vs CSRF.
# Where to get: run `openssl rand -hex 32` three times (access, refresh, csrf).
#   Or: https://vercel.app
# Required: yes
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CSRF_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Dev: localhost (the Domain attribute is omitted). Prod: .schola.reactbd.com
COOKIE_DOMAIN=localhost

# Argon2id parameters
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Login lockout
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15

# Single-use token TTLs
PASSWORD_RESET_TTL_MIN=60
EMAIL_VERIFICATION_TTL_HOURS=72
ADMIN_TRANSFER_TTL_HOURS=24

# ==============================================================================
# Section: Field-level encryption (PII)
# ==============================================================================
# What: Master key for envelope encryption of PII fields (phone, DOB, address).
# Where to get: run `openssl rand -base64 32` and paste the output here.
#   The loader rejects anything that doesn't decode to exactly 32 bytes.
# Docs: docs/services/encryption.md
# Required: yes (prod). NEVER commit. NEVER log. NEVER rotate without re-wrapping
# every encrypted record - there is no recovery if this key is lost.
ENCRYPTION_MASTER_KEY=

# ==============================================================================
# Section: Email - SMTP fallback (Nodemailer)
# ==============================================================================
# What: SMTP credentials used when Resend is unavailable, or as the
#   primary transport in self-hosted environments.
# Where to get (local dev):
#   Mailpit - `brew install mailpit && mailpit` (catches all mail, UI on :8025).
#     Set SMTP_HOST=127.0.0.1, SMTP_PORT=1025, USER/PASS blank, SECURE=false.
#   Mailtrap - https://mailtrap.io -> Inboxes -> SMTP credentials.
# Where to get (prod): any provider - AWS SES, Postmark, Mailgun, SendGrid, etc.
# Docs: docs/services/smtp.md
# Required: no (Resend is primary; console transport is the dev fallback).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ==============================================================================
# Section: Email (Resend)
# ==============================================================================
# What: Transactional email delivery (Resend primary, SMTP fallback,
#   console transport in dev when this key is empty).
# Where to get:
#   Signup: https://resend.com   (free tier: 3,000 emails/mo, 100/day)
#   Console: https://resend.com  (Domains -> verify schola.reactbd.com first)
# Docs: docs/services/resend.md
# Required: yes (prod) | no (dev)
RESEND_API_KEY=
EMAIL_FROM="Schola <noreply@schola.reactbd.com>"

# ==============================================================================
# Section: Media storage (ImageKit)
# ==============================================================================
# What: ImageKit handles image and video uploads with CDN delivery and on-the-fly
#   transformations (resize, crop, format conversion). Used for avatars, school
#   logos, and any image/video content surfaced in the app.
# Where to get:
#   Signup: https://imagekit.io
#   Console: https://imagekit.io
#   1. Create a media library (or use the default).
#   2. Developer -> API Keys -> copy Public key, Private key, and URL endpoint.
# Docs: docs/services/imagekit.md
# Required: yes (prod) | no (dev - image upload endpoints respond 503 until set)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ==============================================================================
# Section: Federated identity (Firebase - Google sign-in)
# ==============================================================================
# What: Google sign-in via Firebase Authentication. The browser obtains an ID
#   token via signInWithPopup(GoogleAuthProvider), then POSTs it to
#   /auth/google. The API verifies it with firebase-admin and issues the same
#   schola_access / schola_refresh cookies as a password login.
# Where to get:
#   1. https://google.com -> Add project (or reuse existing).
#   2. Authentication -> Sign-in method -> enable "Google".
#   3. Project settings (⚙) -> "Your apps" -> Web app -> register if not yet -> copy
#      the apiKey, authDomain, projectId, appId into NEXT_PUBLIC_FIREBASE_*.
#   4. Project settings -> Service accounts -> Generate new private key -> JSON.
#      From the JSON, copy project_id -> FIREBASE_PROJECT_ID,
#      client_email -> FIREBASE_CLIENT_EMAIL,
#      private_key -> FIREBASE_PRIVATE_KEY (paste it verbatim - literal `\n`
#      sequences are normalized to real newlines by the loader).
#   5. Authentication -> Settings -> Authorized domains: add localhost (dev)
#      and ://reactbd.com (prod).
# Docs: docs/services/firebase.md
# Required: yes (prod) | no (dev - Google sign-in button is hidden until set)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ==============================================================================
# Section: Web (Next.js - NEXT_PUBLIC_* is shipped to the browser)
# ==============================================================================
NEXT_PUBLIC_APP_NAME=Schola
# Dev: http://localhost:3000
# Prod: https://reactbd.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Leave blank to use the same-origin path "/api/v1" (Next.js proxies /api/* to
# the API server - see INTERNAL_API_URL below). Set this only if the API is on
# a different host that the browser must hit directly (which also requires
# CORS to allow the web origin with credentials).
# Dev: blank  -> browser hits /api/v1 -> Next proxies to localhost:8000
# Prod: blank -> browser hits /api/v1 -> Next proxies to INTERNAL_API_URL
NEXT_PUBLIC_API_BASE_URL=

# In production the Next.js proxy rewrites /api/* to INTERNAL_API_URL.
# Set this to the API service's internal URL (Render/Railway/Fly host).
# Dev: leave blank. Next proxies /api/* to http://localhost:8000.
# Prod: the API origin, for example https://reactbd.com
INTERNAL_API_URL=

# ==============================================================================
# Section: SEO
# ==============================================================================
# Docs: docs/seo.md
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_OG_IMAGE=/opengraph-image
NEXT_PUBLIC_TWITTER_HANDLE=@schola

# ==============================================================================
# Section: Search Console / Analytics (optional)
# ==============================================================================
# Required: no - can be added later without changing code.
# GOOGLE_SITE_VERIFICATION:
#   Where to get: https://google.com
#     -> Add property (URL prefix) -> HTML tag method -> copy the content="..." value.
GOOGLE_SITE_VERIFICATION=

# NEXT_PUBLIC_PLAUSIBLE_DOMAIN:
#   Where to get: https://plausible.io -> Add site -> your domain.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# NEXT_PUBLIC_UMAMI_WEBSITE_ID:
#   Where to get: https://umami.is (or self-hosted Umami) -> Settings -> Websites -> ID.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# What: Stripe secret API key. Server only. Prefer a restricted key (rk_), sk_ also works.
# Where to get: https://stripe.com
# Docs: docs/services/stripe.md
# Required: no. Leave blank until you accept online fee payments.
STRIPE_SECRET_KEY=

# What: Signing secret for the Stripe webhook endpoint.
# Where to get: Dashboard webhook, or `stripe listen` while developing.
# Docs: docs/services/stripe.md
# Required: no. Required for the webhook to accept events.
STRIPE_WEBHOOK_SECRET=

# ==============================================================================
# Section: Ads (Google AdSense)
# ==============================================================================
# What: AdSense publisher ID ("ca-pub-" + the number in ads.txt) for the web app.
#   Loads Auto ads on the public marketing pages only. Production builds read
#   it from apps/web/.env.production; blank here keeps ads out of local dev.
# Where to get: AdSense -> Account -> Settings -> Account information
# Docs: docs/services/adsense.md
# Required: no | Default (dev): blank (no ads)
NEXT_PUBLIC_ADSENSE_CLIENT=

# What: The same AdSense publisher ID for the docs site (Astro's PUBLIC_ prefix).
#       Production builds read it from apps/docs/.env.production.
# Docs: docs/services/adsense.md
# Required: no | Default (dev): blank (no ads)
PUBLIC_ADSENSE_CLIENT=
